{
  "expo": {
    "name": "My Finance Manager",
    "slug": "my-finance-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "myfinancemanager",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#7357F5",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yaseeninoor.myfinancemanager",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to protect access to your finance app.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yaseeninoor.myfinancemanager",
      "versionCode": 1,
      "edgeToEdgeEnabled": true
    },
    "plugins": [],
    "extra": {
      "privacyNote": "Local-first app. User data is stored on device.",
      "eas": {
        "projectId": "921d4444-41e4-4382-8099-d6daffa680d7"
      }
    }
  }
}
